# Copy to .env and fill in what you need. Existing env vars always win.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
JARVIS_MODEL=gpt-4o-mini
JARVIS_TEMPERATURE=0.3
JARVIS_MAX_STEPS=6
JARVIS_TIMEOUT=120
